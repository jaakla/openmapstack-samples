{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tallinn-transit-api",
  "main": "scripts/gps-worker.js",
  "account_id": "1770d998d043a2778e06edafa880a877",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "cache": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://jaakla.github.io,http://127.0.0.1:5177,http://localhost:5177",
    "GPS_ARCHIVE_BACKGROUND_START": "2026-11-01T07:21:59Z",
    "GPS_ARCHIVE_BACKGROUND_UNTIL": "2026-11-15T07:21:59Z"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GPS_FEED",
        "class_name": "GpsFeed"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GpsFeed"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "pipelines": [
    {
      "binding": "GPS_ARCHIVE",
      "stream": "fb702029f11f4b448ee5e4dfa376e6a8"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
